module fault_stackoverflow;

import core.volatile: volatileLoad, volatileStore;
import core.sys.linux.sys.prctl: PR_SET_DUMPABLE, prctl;
import core.sys.posix.pthread: pthread_create, pthread_join, pthread_t;
import snakebite.faultsignal: runGuest;

private uint recurse(uint n) {
    pragma(inline, false);
    uint[64] pad;
    volatileStore(&pad[0], n);
    return recurse(n + 1) + volatileLoad(&pad[n & 63]);
}

extern(C) private void* enter(void*) {
    runGuest({ recurse(0); });
    return null;
}

int main(string[] args) {
    prctl(PR_SET_DUMPABLE, 0, 0, 0, 0);
    if (args.length == 1)
        enter(null);
    else {
        pthread_t thread;
        if (pthread_create(&thread, null, &enter, null) != 0)
            return 97;
        if (pthread_join(thread, null) != 0)
            return 98;
    }
    return 99;
}
