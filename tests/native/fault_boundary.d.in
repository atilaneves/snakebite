module fault_boundary;

import core.volatile: volatileLoad;
import core.thread.fiber: Fiber;
import core.thread: Thread;
import core.memory: GC;
import core.sys.linux.sys.prctl: PR_SET_DUMPABLE, prctl;
import snakebite.faultsignal: runGuest, GuestBody, HardwareFault, takeFault;

extern(C) void snakebite_fault_invoke(void*, GuestBody);

__gshared uint* pointer;
private int cleaned;

private void leaf() {
    pragma(inline, false);
    volatileLoad(pointer);
}

private void outsideFault() {
    import core.sys.posix.unistd: write;
    enum marker = "outside-run\n";
    write(1, marker.ptr, marker.length);
    leaf;
}

private extern(C) void directBody(void*) {
    leaf;
}

private void entry(bool direct = false) {
    pragma(inline, false);
    scope(exit) ++cleaned;
    if (direct)
        runGuest(null, &directBody);
    else
        runGuest({ leaf; });
}

private bool catchEntry(bool direct = false) {
    try {
        entry(direct);
    } catch (HardwareFault fault) {
        takeFault(fault);
        return true;
    }
    return false;
}

private int finalized;
private bool finalizerFailed;

private final class Collected {
    ~this() {
        const before = cleaned;
        if (!catchEntry(true) || cleaned != before + 1)
            finalizerFailed = true;
        ++finalized;
    }
}

private void allocateCollected() {
    pragma(inline, false);
    cast(void) new Collected;
}

private struct FaultOrder {
    int marked;
    int released;
    bool bad;
    HardwareFault fault;
}

private void markFault(void* context, HardwareFault fault) nothrow @nogc {
    auto order = cast(FaultOrder*) context;
    ++order.marked;
    order.fault = fault;
}

private extern(C) void nativeCleanup(void* context) {
    auto order = cast(FaultOrder*) context;
    scope(exit) {
        order.bad = order.marked != 1;
        ++order.released;
    }
    snakebite_fault_invoke(null, &directBody);
}

private struct FaultOwners {
    FaultOrder outer;
    FaultOrder inner;
}

private extern(C) void nestedCleanup(void* context) {
    auto owners = cast(FaultOwners*) context;
    scope(exit) {
        owners.outer.bad = owners.outer.marked != 1;
        ++owners.outer.released;
    }
    runGuest(&owners.inner, &nativeCleanup, &owners.inner, &markFault);
}

int main(string[] args) {
    prctl(PR_SET_DUMPABLE, 0, 0, 0, 0);
    if (args.length != 2)
        return 64;
    switch (args[1]) {
        case "nested-before-unwind":
            foreach (_; 0 .. 1000) {
                FaultOwners owners;
                bool caught;
                try {
                    runGuest(&owners, &nestedCleanup, &owners.outer, &markFault);
                } catch (HardwareFault fault) {
                    takeFault(fault);
                    caught = fault is owners.inner.fault
                        && fault is owners.outer.fault;
                }
                if (!caught || owners.inner.bad || owners.outer.bad
                        || owners.inner.released != 1
                        || owners.outer.released != 1)
                    return 31;
            }
            return 0;
        case "before-unwind":
        case "after-before-unwind":
            foreach (_; 0 .. 1000) {
                FaultOrder order;
                bool caught;
                try {
                    runGuest(&order, &nativeCleanup, &order, &markFault);
                } catch (HardwareFault fault) {
                    takeFault(fault);
                    caught = fault is order.fault;
                }
                if (!caught || order.bad || order.marked != 1
                        || order.released != 1)
                    return 29;
            }
            if (args[1] == "before-unwind")
                return 0;
            outsideFault;
            return 30;
        case "recover-finalizer":
        case "after-finalizer":
            foreach (_; 0 .. 32) {
                allocateCollected;
                GC.collect;
            }
            if (finalized == 0 || finalizerFailed)
                return 23;
            // A finalizer catch must not leave a pending fault or a run mark.
            if (!catchEntry)
                return 24;
            if (args[1] == "recover-finalizer")
                return 0;
            outsideFault;
            return 25;
        case "recover-thread":
        case "after-thread":
            bool threadRecovered;
            auto thread = new Thread({
                foreach (round; 0 .. 1000)
                    if (!catchEntry(true) || cleaned != round + 1)
                        return;
                threadRecovered = true;
            });
            thread.start;
            thread.join;
            if (!threadRecovered || cleaned != 0)
                return 26;
            if (args[1] == "recover-thread")
                return 0;
            outsideFault;
            return 27;
        case "fibers-fault-first":
            auto faulting = new Fiber({ runGuest({ Fiber.yield(); leaf; }); });
            auto waiting = new Fiber({ runGuest({ Fiber.yield(); }); });
            faulting.call;
            waiting.call;
            bool firstCaught;
            try {
                faulting.call;
            } catch (HardwareFault fault) {
                takeFault(fault);
                firstCaught = true;
            }
            if (!firstCaught)
                return 28;
            waiting.call;
            return 0;
        case "after-suspended":
        case "after-other-fiber-suspended":
            auto suspended = new Fiber({ runGuest({ Fiber.yield(); }); });
            suspended.call;
            void faultOutside() {
                import core.sys.posix.unistd: write;
                enum marker = "outside-run\n";
                write(1, marker.ptr, marker.length);
                try {
                    // No run mark. Keep the catch even in optimized builds.
                    snakebite_fault_invoke(null, &directBody);
                } catch (HardwareFault fault) {
                    takeFault(fault);
                    import core.stdc.stdlib: exit;
                    exit(77);
                }
            }
            if (args[1] == "after-suspended")
                faultOutside;
            else
                (new Fiber({ faultOutside; })).call;
            return 22;
        case "fibers":
        case "after-fibers":
            auto first = new Fiber({ runGuest({ Fiber.yield(); }); });
            auto second = new Fiber({
                runGuest({
                    Fiber.yield();
                    leaf;
                });
            });
            first.call;
            second.call;
            first.call;
            bool fiberCaught;
            try {
                second.call;
            } catch (HardwareFault fault) {
                takeFault(fault);
                fiberCaught = true;
            }
            if (!fiberCaught)
                return 20;
            if (args[1] == "fibers")
                return 0;
            outsideFault;
            return 21;
        case "recover":
        case "after-fault":
        case "recover-direct":
        case "after-fault-direct":
            foreach (round; 0 .. 1000) {
                if (!catchEntry(args[1] == "recover-direct"
                        || args[1] == "after-fault-direct")
                        || cleaned != round + 1)
                    return 10;
            }
            if (args[1] == "recover" || args[1] == "recover-direct")
                return 0;
            outsideFault;
            return 11;
        case "nested":
        case "after-nested":
            foreach (round; 0 .. 1000) {
                bool innerCaught;
                bool outerCaught;
                try {
                    runGuest({
                        innerCaught = catchEntry;
                        leaf;
                    });
                } catch (HardwareFault fault) {
                    takeFault(fault);
                    outerCaught = true;
                }
                if (!innerCaught || !outerCaught || cleaned != round + 1)
                    return 14;
            }
            if (args[1] == "nested")
                return 0;
            outsideFault;
            return 15;
        case "after-return":
            int called;
            runGuest({ ++called; });
            if (called != 1)
                return 16;
            outsideFault;
            return 17;
        case "after-exception":
            auto expected = new Exception("ordinary");
            bool caught;
            try {
                runGuest({ throw expected; });
            } catch (Exception e) {
                caught = e is expected;
            }
            if (!caught)
                return 18;
            outsideFault;
            return 19;
        default:
            return 64;
    }
}
