module fault_process;

import core.atomic: atomicLoad, atomicStore;
import core.memory: GC;
import core.sys.linux.sys.prctl: PR_SET_DUMPABLE, prctl;
import core.sys.posix.pthread: pthread_create, pthread_join, pthread_t;
import core.sys.posix.signal:
    raise, sigaction, sigaction_t, SIG_IGN, SIGSEGV;
import core.sys.posix.unistd: _exit, alarm, usleep;
import core.thread: Thread;
import core.volatile: volatileLoad;
import snakebite.backends.guestfault: GuestFault;
import snakebite.backends.haltprocess: haltProcess;
import snakebite.faultsignal:
    HardwareFault, installFaultHandlers, runGuest, takeFault;
import std.process: environment;
import std.exception: enforce;

__gshared uint* pointer;

private void load() {
    pragma(inline, false);
    volatileLoad(pointer);
}

private void divide() {
    // A hardware divide, including in release and LTO builds.
    asm {
        mov EAX, 1;
        xor EDX, EDX;
        xor ECX, ECX;
        idiv ECX;
    }
}

extern(C) private void previousHandler(int) nothrow @nogc {
    _exit(43);
}

extern(C) private void guestHandler(int) nothrow @nogc {
    _exit(42);
}

private void faultInCleanup() {
    scope(exit) load;
    runGuest({ load; });
}

private final class Filler {
    void*[(__traits(classInstanceSize, HardwareFault) + 7) / 8] words;
}

private shared bool ready;
private shared bool release;
private shared bool caught;

extern(C) private void* guestThread(void*) {
    runGuest({
        atomicStore(ready, true);
        while (!atomicLoad(release))
            usleep(1000);
        load;
    });
    return null;
}

extern(C) private void* catchGuestThread(void* argument) {
    try
        return guestThread(argument);
    catch (HardwareFault fault) {
        takeFault(fault);
        atomicStore(caught, fault.kind == GuestFault.Kind.nullDereference);
        return null;
    }
}

private int collectBeforeForeignFault() {
    pthread_t thread;
    enforce(pthread_create(&thread, null, &catchGuestThread, null) == 0);
    while (!atomicLoad(ready))
        usleep(1000);
    foreach (round; 0 .. 200) {
        GC.collect;
        foreach (index; 0 .. 500)
            cast(void) new Filler;
    }
    atomicStore(release, true);
    enforce(pthread_join(thread, null) == 0);
    return atomicLoad(caught) ? 77 : 98;
}

int main(string[] args) {
    prctl(PR_SET_DUMPABLE, 0, 0, 0, 0);
    alarm(30);
    if (args.length != 2)
        return 64;

    const scenario = args[1];
    if (scenario == "previousHandler" || scenario == "sentSignalWhileIgnored") {
        // Python disables constructor installation for these two cases.
        // The prior action must exist before installation, not after it.
        sigaction_t previous;
        previous.sa_handler = scenario == "previousHandler"
            ? &previousHandler : SIG_IGN;
        enforce(sigaction(SIGSEGV, &previous, null) == 0);
        environment.remove("SNAKEBITE_NO_FAULT_HANDLER");
        enforce(installFaultHandlers);
    }

    switch (scenario) {
        case "hostNullRead":
            load;
            break;
        case "hostDivision":
            divide;
            break;
        case "hostFaultOnAnotherThread":
            runGuest({
                auto thread = new Thread({ load; });
                thread.start;
                thread.join;
            });
            break;
        case "hostFaultAfterGuestRun":
            runGuest({});
            load;
            break;
        case "sentSignalInGuestRun":
            runGuest({ raise(SIGSEGV); });
            break;
        case "previousHandler":
            load;
            break;
        case "faultInCleanup":
            runGuest({ faultInCleanup; });
            break;
        case "sentSignalWhileIgnored":
            runGuest({ raise(SIGSEGV); });
            return 77;
        case "faultOnAThreadOfTheGuestAfterCollections":
            return collectBeforeForeignFault;
        case "guestFaultWithTheHandlersOff":
            runGuest({ load; });
            break;
        case "guestHandler":
            runGuest({
                sigaction_t own;
                own.sa_handler = &guestHandler;
                enforce(sigaction(SIGSEGV, &own, null) == 0);
                load;
            });
            break;
        case "halt":
            runGuest({ haltProcess; });
            break;
        default:
            return 64;
    }
    return 99;
}
