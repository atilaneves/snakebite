name "rt-cerealed-1"
description "all cerealed tests but fake unit-threaded"
targetType "library"
targetPath "bin"
dflags "-checkaction=context"


configuration "unittest" {
    targetType "executable"
    targetName "ut"
    targetPath "bin"

    mainSourceFile "tests/main.d"
    excludedSourceFiles "source/main.d"
    sourcePaths "tests"
    importPaths "tests"
}
