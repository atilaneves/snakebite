+import snakebite.memory.arrayallocation :
+    ArrayAllocationRequest, ArrayAllocationSlots, ArrayAllocationTls, arrayAllocationMaxSpares;
+
+private ArrayAllocationRequest* _arrayAllocationRequest;
+
+extern(C) ArrayAllocationTls arrayAllocationTls() nothrow @nogc
+{
+    import ldc.llvmasm : __asm;
+
+    if (!Gcx.instance || ConservativeGC.isPrecise || config.fork)
+        return ArrayAllocationTls.init;
+    debug(LOGGING) return ArrayAllocationTls.init;
+    debug(SENTINEL) return ArrayAllocationTls.init;
+    debug(VALGRIND) return ArrayAllocationTls.init;
+
+    // The overlay is linked into the executable. On x86-64 Linux its
+    // TLS variables have fixed offsets from the thread pointer in FS.
+    const base = __asm!ptrdiff_t("movq %fs:0, $0", "=r");
+    const finalizer = cast(ptrdiff_t) &ConservativeGC._inFinalizer - base;
+    const allocated = cast(ptrdiff_t) &bytesAllocated - base;
+    if (finalizer < int.min || finalizer >= 0 || allocated < int.min || allocated >= 0)
+        return ArrayAllocationTls.init;
+    return ArrayAllocationTls(cast(int) finalizer, cast(int) allocated);
+}
+
+extern(C) ArrayAllocationRequest* exchangeArrayAllocationRequest(
+    ArrayAllocationRequest* request) nothrow @nogc
+{
+    auto previous = _arrayAllocationRequest;
+    _arrayAllocationRequest = request;
+    return previous;
+}
