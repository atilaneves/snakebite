name "snakebite"
description "Backends for the D programming language"
copyright "Copyright © 2026, atila"
license "BSL-1.0"

dependency "dmd:frontend" version="~>2.113.0"
dependency ":dmd-backend-vendor" version="*"

// When bumping dmd:frontend, re-run scripts/vendor-dmd-backend.sh to
// keep vendor/dmd-backend/ in sync with the new version.
subPackage {
    name "dmd-backend-vendor"
    targetType "sourceLibrary"
    sourcePaths "vendor/dmd-backend"
    importPaths "vendor/dmd-backend"
}


configuration "unittest" {
    targetType "executable"
    targetName "ut"
    targetPath "bin"
    // A non-root guest declaration runs as the native symbol the host
    // already links, druntime template instantiations included, so the
    // executable's own symbols must be visible to `dlsym`.
    lflags "--export-dynamic" platform="linux"

    mainSourceFile "tests/main.d"
    sourcePaths "tests"
    sourcePaths "bench"
    excludedSourceFiles "bench/main.d"
    importPaths "tests"
    importPaths "."

    dependency "unit-threaded" version="*"
}

configuration "acceptance-test" {
    targetType "executable"
    targetName "at"
    targetPath "bin"
    lflags "--export-dynamic" platform="linux"

    mainSourceFile "acceptance/main.d"
    sourcePaths "acceptance"
    sourcePaths "bench"
    excludedSourceFiles "bench/main.d"
    importPaths "acceptance"
    importPaths "."

    dependency "unit-threaded" version="*"
}

// The test runner: `build/sb.sh` produces `bin/sb` with LDC in release mode.
configuration "sb" {
    targetType "executable"
    targetName "sb"
    targetPath "bin"
    lflags "--export-dynamic" platform="linux"

    mainSourceFile "source/snakebite/main.d"
    importPaths "."
}

// The interactive REPL: `dub build -c sb-repl` produces `bin/sb-repl`.
configuration "sb-repl" {
    targetType "executable"
    targetName "sb-repl"
    targetPath "bin"
    lflags "--export-dynamic" platform="linux"

    mainSourceFile "source/snakebite/repl/main.d"
    importPaths "."

    dependency "readline" version="0.3.0"
}

// Built by build/bench.sh with LDC in release mode: the backends must
// be optimised for the benchmark numbers to mean anything.
configuration "bench" {
    targetType "executable"
    targetName "bench"
    targetPath "bin"
    lflags "--export-dynamic" platform="linux"

    mainSourceFile "bench/main.d"
    sourcePaths "bench"
    importPaths "."
}
